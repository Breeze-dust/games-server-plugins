<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.murdermystery</groupId>
    <artifactId>murder-mystery</artifactId>
    <version>1.1.0</version>
    <packaging>jar</packaging>

    <name>MurderMystery</name>
    <description>密室杀手小游戏：杀手隐身行凶，侦探射杀凶手，无辜者收集金币自救</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>21</maven.compiler.release>
    </properties>

    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
        <!-- Simple Voice Chat 官方仓库（voicechat-api 只用来编译，运行时由 SVC 插件提供） -->
        <repository>
            <id>maxhenkel</id>
            <url>https://maven.maxhenkel.de/repository/public/</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>26.2.build.126-stable</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.hub</groupId>
            <artifactId>minigame-lib</artifactId>
            <version>1.0.0</version>
            <scope>provided</scope>
        </dependency>
        <!-- Simple Voice Chat 的官方 API（可选集成，provided：打包时不带，运行时由 voicechat 插件提供） -->
        <dependency>
            <groupId>de.maxhenkel.voicechat</groupId>
            <artifactId>voicechat-api</artifactId>
            <version>2.6.27</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>MurderMystery</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.1</version>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Implementation-Title>MurderMystery</Implementation-Title>
                            <Implementation-Version>${project.version}</Implementation-Version>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
